{
  "name": "@wangxiaocuo/dsh-session-trash",
  "version": "0.6.3",
  "description": "DeepSeek Harness plugin: move cold sessions into a recoverable trash, restore them within the retention window, or delete their logs permanently.",
  "license": "MIT",
  "author": "wangxiaocuo",
  "homepage": "https://github.com/wangxiaocuo/dsh-session-trash#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangxiaocuo/dsh-session-trash.git"
  },
  "bugs": {
    "url": "https://github.com/wangxiaocuo/dsh-session-trash/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "session",
    "trash",
    "recycle-bin"
  ],
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/run-unit.mjs",
    "test:coverage": "node test/run-unit.mjs --experimental-test-coverage",
    "test:e2e": "node test/e2e-web.mjs",
    "test:smoke": "node test/smoke-host.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:dom": "node --test test/client-dom.test.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "20.19.43",
    "jsdom": "27.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
